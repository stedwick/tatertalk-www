---
import { Image } from "astro:assets";
import { PUBLIC_APP_URL, PUBLIC_YOUTUBE_VIDEO_URL } from "astro:env/client";
import logo from "../../assets/logo.png";
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16"
>
  <!-- Animated Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute top-1/4 left-1/4 w-64 h-64 bg-cyan-400 rounded-full mix-blend-multiply filter blur-xl slow-pulse"
    >
    </div>
    <div
      class="absolute top-3/4 right-1/4 w-72 h-72 bg-blue-500 rounded-full mix-blend-multiply filter blur-xl slow-pulse"
      style="animation-delay: 1.5s;"
    >
    </div>
    <div
      class="absolute bottom-1/4 left-1/2 w-80 h-80 bg-purple-500 rounded-full mix-blend-multiply filter blur-xl slow-pulse"
      style="animation-delay: 3s;"
    >
    </div>
  </div>

  <!-- Sound Wave Pattern -->
  <div class="absolute inset-0 opacity-5">
    <svg
      class="w-full h-full"
      viewBox="0 0 1200 800"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <linearGradient id="waveGradient" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" style="stop-color:#1dd3b0;stop-opacity:1"></stop>
          <stop offset="50%" style="stop-color:#16537e;stop-opacity:1"></stop>
          <stop offset="100%" style="stop-color:#7209b7;stop-opacity:1"></stop>
        </linearGradient>
      </defs>
      <path
        d="M0,400 Q300,200 600,400 T1200,400"
        stroke="url(#waveGradient)"
        stroke-width="2"
        fill="none"
        class="slow-pulse"></path>
      <path
        d="M0,350 Q300,250 600,350 T1200,350"
        stroke="url(#waveGradient)"
        stroke-width="1"
        fill="none"
        class="slow-pulse"
        style="animation-delay: 1.5s;"></path>
      <path
        d="M0,450 Q300,350 600,450 T1200,450"
        stroke="url(#waveGradient)"
        stroke-width="1"
        fill="none"
        class="slow-pulse"
        style="animation-delay: 3s;"></path>
    </svg>
  </div>

  <div
    class="relative z-10 max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 text-center"
  >
    <!-- Main Content -->
    <div class="space-y-8">
      <!-- Microphone Icon with Pulse Effect -->
      <div class="flex justify-center mb-8">
        <div class="relative">
          <!-- Pulse rings -->
          <div
            class="absolute inset-0 rounded-full border-2 border-cyan-400 slow-pulse-ring"
          >
          </div>
          <div
            class="absolute inset-0 rounded-full border-2 border-cyan-400 slow-pulse-ring"
            style="animation-delay: 2s;"
          >
          </div>
          <!-- Logo container - positioned above pulse rings -->
          <div
            class="relative z-10 w-24 h-24 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-full flex items-center justify-center slow-pulse-glow p-2"
          >
            <Image
              src={logo}
              alt="Tater Talk Microphone"
              width={80}
              height={80}
              densities={[1, 2]}
              class="w-20 h-20 object-contain bg-white rounded-full"
            />
          </div>
        </div>
      </div>

      <!-- Main Headline -->
      <div class="space-y-4">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold tracking-tight"
        >
          <span class="text-white">The Easiest Way to</span><br />
          <span class="gradient-text">Talk to Your Computer!</span>
        </h1>

        <p
          class="text-lg sm:text-xl md:text-2xl text-slate-300 max-w-4xl mx-auto leading-relaxed px-2"
        >
          Transform your voice into text with our cross-platform speech-to-text
          web app.
          <span class="text-cyan-400 font-medium">No downloads, no setup</span
          >—just talk.
        </p>
      </div>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center pt-8 px-4"
      >
        <a
          href={PUBLIC_APP_URL}
          class="group w-full sm:w-auto px-6 sm:px-8 py-3 sm:py-4 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-semibold text-base sm:text-lg rounded-xl transition-all duration-300 transform hover:scale-105 shadow-xl hover:shadow-cyan-400/25 cursor-pointer inline-block"
        >
          <span class="flex items-center justify-center space-x-2">
            <span>Start Talking Now</span>
            <svg
              class="w-4 h-4 sm:w-5 sm:h-5 group-hover:translate-x-1 transition-transform duration-200"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </span>
        </a>

        <a
          href={PUBLIC_YOUTUBE_VIDEO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group w-full sm:w-auto px-6 sm:px-8 py-3 sm:py-4 bg-slate-800/50 hover:bg-slate-700/50 text-white font-medium text-base sm:text-lg rounded-xl border border-slate-600 hover:border-slate-500 transition-all duration-300 cursor-pointer inline-block"
        >
          <span class="flex items-center justify-center space-x-2">
            <svg
              class="w-4 h-4 sm:w-5 sm:h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Watch Demo</span>
          </span>
        </a>
      </div>

      <!-- Scroll indicator -->
      <div class="flex justify-center pt-8 pb-4">
        <div class="animate-bounce">
          <svg
            class="w-6 h-6 text-slate-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </div>

      <!-- Trust Indicators -->
      <div class="pt-12 space-y-4">
        <p class="text-slate-400 text-sm font-medium uppercase tracking-wider">
          Works on all devices
        </p>
        <div
          class="flex flex-wrap justify-center items-center gap-3 sm:gap-6 md:gap-8 text-slate-500 px-4"
        >
          <!-- Browser Icons -->
          <div class="flex items-center space-x-1 sm:space-x-2">
            <span class="text-xl sm:text-2xl">🌐</span>
            <span class="text-xs sm:text-sm">Web Browser</span>
          </div>
          <div class="flex items-center space-x-1 sm:space-x-2">
            <span class="text-xl sm:text-2xl">💻</span>
            <span class="text-xs sm:text-sm">Desktop</span>
          </div>
          <div class="flex items-center space-x-1 sm:space-x-2">
            <span class="text-xl sm:text-2xl">📱</span>
            <span class="text-xs sm:text-sm">Mobile</span>
          </div>
          <div class="flex items-center space-x-1 sm:space-x-2">
            <span class="text-xl sm:text-2xl">📟</span>
            <span class="text-xs sm:text-sm">Tablet</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(3deg);
    }
  }

  .float-animation {
    animation: float 3s ease-in-out infinite;
  }
</style>

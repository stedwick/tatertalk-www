---
import { Image } from "astro:assets";
import { PUBLIC_YOUTUBE_VIDEO_URL } from "astro:env/client";
import logo from "../../assets/logo.png";
---

<section
  id="demo"
  class="py-16 relative overflow-hidden border-t border-slate-800"
>
  <!-- Background Elements -->
  <div class="absolute inset-0 opacity-10">
    <div
      class="absolute top-1/2 left-0 w-72 h-72 bg-gradient-to-r from-cyan-400 to-blue-500 rounded-full mix-blend-multiply filter blur-3xl transform -translate-x-1/2"
    >
    </div>
    <div
      class="absolute top-1/2 right-0 w-72 h-72 bg-gradient-to-r from-purple-400 to-pink-500 rounded-full mix-blend-multiply filter blur-3xl transform translate-x-1/2"
    >
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
    <div
      class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center text-center lg:text-left"
    >
      <!-- Left Content -->
      <div class="space-y-8">
        <div class="space-y-4">
          <div
            class="inline-flex items-center space-x-2 bg-slate-800/50 backdrop-blur-sm border border-slate-700 rounded-full px-6 py-3"
          >
            <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"
            ></span>
            <span class="text-slate-300 font-medium">Live Demo</span>
          </div>

          <h2 class="text-4xl sm:text-5xl font-bold text-white">
            See <span class="gradient-text">Tater Talk</span> in Action
          </h2>

          <p class="text-xl text-slate-300 leading-relaxed">
            Watch real‑time speech‑to‑text dictation in your browser (Chrome/Safari).
            No setup required. Just click and start talking!
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-2xl font-semibold text-white">How it works:</h3>
          <div class="space-y-3 inline-block">
            <div class="flex items-center space-x-3">
              <div
                class="w-8 h-8 bg-cyan-500 rounded-full flex items-center justify-center text-white font-semibold text-sm flex-shrink-0"
              >
                1
              </div>
              <p class="text-slate-300 text-left">
                Click the microphone button
              </p>
            </div>
            <div class="flex items-center space-x-3">
              <div
                class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center text-white font-semibold text-sm flex-shrink-0"
              >
                2
              </div>
              <p class="text-slate-300 text-left">Start speaking naturally</p>
            </div>
            <div class="flex items-center space-x-3">
              <div
                class="w-8 h-8 bg-purple-500 rounded-full flex items-center justify-center text-white font-semibold text-sm flex-shrink-0"
              >
                3
              </div>
              <p class="text-slate-300 text-left">
                Watch your words appear instantly
              </p>
            </div>
          </div>
        </div>

        <a
          href={PUBLIC_YOUTUBE_VIDEO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group px-8 py-4 bg-gradient-to-r from-green-500 to-emerald-600 hover:from-green-400 hover:to-emerald-500 text-white font-semibold text-lg rounded-xl transition-all duration-300 transform hover:scale-105 cursor-pointer inline-block"
        >
          <span class="flex items-center space-x-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                clip-rule="evenodd"></path>
            </svg>
            <span class="hidden xs:inline">Watch Demo Video</span>
            <span class="inline xs:hidden">Watch Demo</span>
          </span>
        </a>
      </div>

      <!-- Right Demo Mockup -->
      <div class="relative">
        <!-- Browser Window Mockup -->
        <div
          class="bg-slate-800 rounded-2xl border border-slate-700 overflow-hidden shadow-2xl"
        >
          <!-- Browser Header -->
          <div
            class="flex items-center justify-between px-6 py-4 bg-slate-900 border-b border-slate-700"
          >
            <div class="flex items-center space-x-3">
              <div class="flex space-x-2">
                <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
              </div>
              <div class="text-slate-400 text-sm">tatertalk.app</div>
            </div>
          </div>

          <!-- Demo Interface -->
          <div class="p-8 space-y-6">
            <!-- Microphone Button -->
            <div class="flex justify-center">
              <button
                class="relative w-20 h-20 bg-gradient-to-br from-red-500 to-pink-600 rounded-full flex items-center justify-center pulse-glow hover:scale-110 transition-transform duration-300 p-3 cursor-pointer"
              >
                <Image
                  src={logo}
                  alt="Tater Talk Microphone"
                  width={48}
                  height={48}
                  densities={[1, 2]}
                  class="w-full h-full object-contain drop-shadow-lg filter contrast-150 brightness-110"
                />
              </button>
            </div>

            <!-- Status -->
            <div class="text-center">
              <div
                class="inline-flex items-center space-x-2 bg-green-500/20 text-green-400 px-4 py-2 rounded-full border border-green-500/30"
              >
                <div class="w-2 h-2 bg-green-400 rounded-full animate-pulse">
                </div>
                <span class="font-medium">Listening...</span>
              </div>
            </div>

            <!-- Live Transcription -->
            <div class="bg-slate-900/50 rounded-xl p-6 border border-slate-700">
              <div class="space-y-4">
                <div class="text-slate-400 text-sm font-medium">
                  Live Transcription:
                </div>
                <div class="text-white text-lg text-left leading-relaxed">
                  <span class="inline-block xs:hidden typing-animation-xs">
                    Hello, this is a demonstration of Tater Talk's real-time
                    speech-to-text capabilities. As you can see, the words
                    appear instantly as I speak...
                  </span>
                  <span class="hidden xs:inline-block typing-animation">
                    Hello, this is a demonstration of Tater Talk's real-time
                    speech-to-text capabilities. As you can see, the words
                    appear instantly as I speak...
                  </span>
                  <span class="text-cursor text-2xl">|</span>
                </div>
              </div>
            </div>

            <!-- Actions -->
            <div class="flex justify-center space-x-4">
              <button
                class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors duration-200 cursor-pointer"
              >
                Copy Text
              </button>
              <button
                class="px-4 py-2 bg-slate-700 hover:bg-slate-600 text-white rounded-lg transition-colors duration-200 cursor-pointer"
              >
                Clear
              </button>
            </div>
          </div>
        </div>

        <!-- Floating Sound Waves -->
        <div class="absolute -top-4 -right-4 w-24 h-24 opacity-30">
          <svg viewBox="0 0 100 100" class="w-full h-full animate-spin-slow">
            <circle
              cx="50"
              cy="50"
              r="10"
              fill="none"
              stroke="url(#soundGradient)"
              stroke-width="2"
              opacity="0.8"></circle>
            <circle
              cx="50"
              cy="50"
              r="20"
              fill="none"
              stroke="url(#soundGradient)"
              stroke-width="1"
              opacity="0.6"></circle>
            <circle
              cx="50"
              cy="50"
              r="30"
              fill="none"
              stroke="url(#soundGradient)"
              stroke-width="1"
              opacity="0.4"></circle>
            <defs>
              <linearGradient
                id="soundGradient"
                x1="0%"
                y1="0%"
                x2="100%"
                y2="100%"
              >
                <stop offset="0%" style="stop-color:#1dd3b0;stop-opacity:1"
                ></stop>
                <stop offset="100%" style="stop-color:#16537e;stop-opacity:1"
                ></stop>
              </linearGradient>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes spin-slow {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .animate-spin-slow {
    animation: spin-slow 20s linear infinite;
  }

  .text-cursor {
    display: inline;
    color: #1dd3b0;
    font-family: "Monaco", "Menlo", "Ubuntu Mono", monospace;
    font-weight: normal;
    vertical-align: super;
    line-height: 1;
    animation: blink 1.5s infinite;
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }
</style>

<!-- VideoObject JSON-LD for Demo Video -->
<script type="application/ld+json" is:inline>
  {JSON.stringify({
    "@context": "https://schema.org",
    "@type": "VideoObject",
    name: "Tater Talk 1-Minute Demo",
    description: "Watch how easy it is to convert speech to text in real-time with Tater Talk.",
    thumbnailUrl: [
      "https://tatertalk.app/twitter2.jpg"
    ],
    uploadDate: "2024-01-01",
    embedUrl: PUBLIC_YOUTUBE_VIDEO_URL,
    contentUrl: PUBLIC_YOUTUBE_VIDEO_URL
  })}
  </script>

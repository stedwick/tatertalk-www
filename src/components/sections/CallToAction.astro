---
import { Image } from "astro:assets";
import { PUBLIC_APP_URL, PUBLIC_YOUTUBE_VIDEO_URL } from "astro:env/client";
import logo from "../../assets/logo.png";
import { Icon } from "astro-icon/components";
---

<section class="pt-16 pb-26 relative overflow-hidden border-t border-slate-800">
  <!-- Animated Background -->
  <div class="absolute inset-0">
    <div
      class="absolute inset-0 bg-gradient-to-br from-slate-900 via-purple-900/20 to-slate-900"
    >
    </div>
    <div
      class="absolute top-1/4 left-1/4 w-96 h-96 bg-cyan-400 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-pulse"
      style="animation-delay: 2s;"
    >
    </div>
  </div>

  <div
    class="relative z-10 max-w-4xl mx-auto px-6 sm:px-8 lg:px-12 text-center"
  >
    <div class="space-y-8">
      <!-- Main CTA Content -->
      <div class="space-y-6">
        <h2 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white">
          Ready to <span class="gradient-text">Start Talking</span>?
        </h2>

        <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
          Join hundreds of users who have already discovered the easiest way to
          convert speech to text. It's free! Start talking to your computer
          today 🎙️
        </p>
      </div>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center items-center pt-8 px-4"
      >
        <a
          href={PUBLIC_APP_URL}
          class="group w-full sm:w-auto px-8 sm:px-10 py-4 sm:py-5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-white font-bold text-lg sm:text-xl rounded-2xl transition-all duration-300 transform hover:scale-105 shadow-2xl hover:shadow-cyan-400/30 cursor-pointer inline-block"
        >
          <span class="flex items-center space-x-3 justify-center">
            <span>Talk Now</span>
            <svg
              class="w-9 h-9 group-hover:translate-x-1 transition-transform duration-200"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </span>
        </a>

        <a
          href={PUBLIC_YOUTUBE_VIDEO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group w-full sm:w-auto px-8 sm:px-10 py-4 sm:py-5 bg-transparent border-2 border-slate-600 hover:border-slate-500 text-white font-semibold text-md sm:text-lg rounded-2xl transition-all duration-300 hover:bg-slate-800/30 cursor-pointer inline-block"
        >
          <span class="flex items-center space-x-3 justify-center">
            <span>Watch Demo</span>
            <svg
              class="w-9 h-9"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
        </a>
      </div>

      <!-- Trust Signals -->
      <div class="pt-16 space-y-8">
        <!-- Stats -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          <div class="space-y-2">
            <div class="text-3xl font-bold gradient-text">99.5%</div>
            <div class="text-slate-400 text-sm">Accuracy Rate</div>
          </div>
          <div class="space-y-2">
            <div class="text-3xl font-bold gradient-text">50ms</div>
            <div class="text-slate-400 text-sm">Response Time</div>
          </div>
          <div class="space-y-2">
            <div class="text-3xl font-bold gradient-text">24/7</div>
            <div class="text-slate-400 text-sm">Availability</div>
          </div>
        </div>

        <!-- Benefits List -->
        <div class="flex flex-wrap justify-center gap-6 pt-8">
          <div class="flex items-center space-x-2 text-slate-300">
            <Icon name="mdi:web" class="w-5 h-5 text-blue-400" />
            <span>No installation required</span>
          </div>
          <div class="flex items-center space-x-2 text-slate-300">
            <Icon name="mdi:devices" class="w-5 h-5 text-green-400" />
            <span>Works on all devices</span>
          </div>
          <div class="flex items-center space-x-2 text-slate-300">
            <Icon name="twemoji:beer-mug" class="w-5 h-5" />
            <span>Free as in Beer</span>
          </div>
          <div class="flex items-center space-x-2 text-slate-300">
            <Icon name="logos:chrome" class="w-5 h-5" />
            <span>Works best in Chrome</span>
          </div>
          <!-- <div class="flex items-center space-x-2 text-slate-300">
            <svg
              class="w-5 h-5 text-green-400"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Privacy focused</span>
          </div> -->
        </div>
      </div>
    </div>
  </div>

  <!-- Microphone Animation -->
  <div class="absolute bottom-4 left-1/2 transform -translate-x-1/2 opacity-40">
    <div
      class="w-16 h-16 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-full flex items-center justify-center subtle-bounce p-3"
    >
      <Image
        src={logo}
        alt="Tater Talk"
        width={32}
        height={32}
        densities={[1, 2]}
        class="w-full h-full object-contain drop-shadow-lg filter contrast-150 brightness-110"
      />
    </div>
  </div>
</section>

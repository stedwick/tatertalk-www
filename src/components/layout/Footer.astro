---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import logo from "../../assets/logo.png";
import {
  PUBLIC_YOUTUBE_VIDEO_URL,
  PUBLIC_TWITTER_URL,
  PUBLIC_GITHUB_URL,
  PUBLIC_YOUTUBE_CHANNEL_URL,
  PUBLIC_FACEBOOK_URL,
  PUBLIC_PERSONAL_WEBSITE_URL,
  PUBLIC_PHILS_APP_URL,
  PUBLIC_LINKEDIN_URL,
  PUBLIC_PRIVACY_POLICY_URL,
  PUBLIC_MAILTO_URL,
} from "astro:env/client";

const currentYear = new Date().getFullYear();
---

<footer
  class="bg-slate-900/50 backdrop-blur-sm border-t border-slate-800 py-16"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      <!-- Logo and Description -->
      <div
        class="space-y-4 flex flex-col items-start xs:items-center sm:items-start"
      >
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-lg overflow-hidden">
            <Image
              src={logo}
              alt="Tater Talk Logo"
              width={40}
              height={40}
              densities={[1, 2]}
              class="w-full h-full object-contain"
            />
          </div>
          <div class="flex items-center space-x-1">
            <span class="text-xl font-bold text-white">Tater</span>
            <span class="text-xl font-bold gradient-text">Talk</span>
          </div>
        </div>
        <p
          class="text-slate-400 max-w-md text-left xs:text-center sm:text-left"
        >
          The easiest way to talk to your computer. Transform your voice into
          text with our cross-platform speech-to-text web app.
        </p>
        <div class="flex space-x-4">
          <a
            href={PUBLIC_TWITTER_URL}
            title="Follow @stedwick on X (Twitter)"
            class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
          >
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"
              ></path>
            </svg>
          </a>
          <a
            href={PUBLIC_GITHUB_URL}
            title="View @stedwick's code on GitHub"
            class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
          >
            <svg
              class="w-5 h-5"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
          <a
            href={PUBLIC_YOUTUBE_CHANNEL_URL}
            title="Watch Philip's videos on YouTube"
            class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
          >
            <Icon name="simple-icons:youtube" class="w-5 h-5" />
          </a>
          <a
            href={PUBLIC_FACEBOOK_URL}
            title="Connect with Philip on Facebook"
            class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
          >
            <Icon name="simple-icons:facebook" class="w-5 h-5" />
          </a>
          <a
            href={PUBLIC_PERSONAL_WEBSITE_URL}
            title="Visit Philip's personal website"
            class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
          >
            <Icon name="mdi:web" class="w-5 h-5" />
          </a>
          <a
            href={PUBLIC_PHILS_APP_URL}
            title="Explore Phil's App - tools and projects"
            class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
          >
            <Icon name="mdi:application" class="w-5 h-5" />
          </a>
          <a
            href={PUBLIC_LINKEDIN_URL}
            title="Connect with Philip on LinkedIn"
            class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
          >
            <Icon name="simple-icons:linkedin" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <div class="flex flex-col xs:flex-row gap-8 xs:justify-around">
        <!-- Quick Links -->
        <div>
          <h3 class="text-white font-semibold mb-4">Product</h3>
          <ul class="space-y-2">
            <li>
              <a
                href="#features"
                class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
                >Features</a
              >
            </li>
            <li>
              <a
                href="#demo"
                class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
                >Demo</a
              >
            </li>
            <li>
              <a
                href="#features"
                class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
                >Pricing (Free!)</a
              >
            </li>
            <li>
              <a
                href={PUBLIC_PHILS_APP_URL}
                class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
                >Blog</a
              >
            </li>
          </ul>
        </div>

        <!-- Support -->
        <div>
          <h3 class="text-white font-semibold mb-4">Support</h3>
          <ul class="space-y-2">
            <li>
              <a
                href={PUBLIC_YOUTUBE_VIDEO_URL}
                class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
                >1-Minute Tutorial</a
              >
            </li>
            <li>
              <a
                href={PUBLIC_MAILTO_URL}
                class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
                >Contact Phil</a
              >
            </li>
            <li>
              <a
                href={PUBLIC_PRIVACY_POLICY_URL}
                class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
                >Privacy Policy</a
              >
            </li>
            <li>
              <a
                href={PUBLIC_PHILS_APP_URL}
                class="text-slate-400 hover:text-white transition-colors duration-200 cursor-pointer"
                >Terms of Service</a
              >
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-800 mt-12 pt-8 text-center">
      <p class="text-slate-400">
        © {currentYear} by Philip Brocoum. Made with ❤️ for better accessibility.
      </p>
    </div>
  </div>
</footer>

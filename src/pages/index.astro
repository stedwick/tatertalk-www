---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Features from "../components/sections/Features.astro";
import Demo from "../components/sections/Demo.astro";
import CallToAction from "../components/sections/CallToAction.astro";
import FAQ from "../components/sections/FAQ.astro";
import Footer from "../components/layout/Footer.astro";
---

<Layout
  title="Tater Talk: Free Cross-Platform Speech-to-Text Dictation Web App"
  description="Transform your voice into text with Tater Talk — a free, browser-based dictation app for desktop and mobile. No downloads. Start dictating now."
>
  <Header />

  <main id="top">
    <Hero />
    <Demo />
    <Features />
    <FAQ />
    <CallToAction />
  </main>

  <Footer />
</Layout>

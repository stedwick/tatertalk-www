---
import "../styles/global.css";
import {
  PUBLIC_TWITTER_URL,
  PUBLIC_GITHUB_URL,
  PUBLIC_YOUTUBE_CHANNEL_URL,
  PUBLIC_FACEBOOK_URL,
  PUBLIC_PERSONAL_WEBSITE_URL,
  PUBLIC_PHILS_APP_URL,
  PUBLIC_LINKEDIN_URL,
} from "astro:env/client";

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "The easiest way to talk to your computer!" } =
  Astro.props;
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href="https://tatertalk.app/" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0ea5e9" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />

    <!-- Meta Tags Generated via https://www.opengraph.xyz -->
    <!-- Facebook Meta Tags -->
    <meta property="og:url" content="https://tatertalk.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Tater Talk" />
    <meta property="og:image" content="https://tatertalk.app/twitter2.jpg" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="tatertalk.app" />
    <meta property="twitter:url" content="https://tatertalk.app/" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@stedwick" />
    <meta name="twitter:creator" content="@stedwick" />
    <meta name="twitter:image" content="https://tatertalk.app/twitter2.jpg" />

    <!-- Structured Data: WebApplication & Organization -->
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "Tater Talk",
        applicationCategory: "BusinessApplication",
        operatingSystem: "Windows, macOS, Linux, iOS, Android",
        url: "https://tatertalk.app/",
        description,
        offers: { "@type": "Offer", price: 0, priceCurrency: "USD" },
        sameAs: [
          PUBLIC_TWITTER_URL,
          PUBLIC_GITHUB_URL,
          PUBLIC_YOUTUBE_CHANNEL_URL,
          PUBLIC_FACEBOOK_URL,
          PUBLIC_PERSONAL_WEBSITE_URL,
          PUBLIC_PHILS_APP_URL,
          PUBLIC_LINKEDIN_URL
        ].filter(Boolean)
      })}
    </script>
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Tater Talk",
        url: "https://tatertalk.app/",
        sameAs: [
          PUBLIC_TWITTER_URL,
          PUBLIC_GITHUB_URL,
          PUBLIC_YOUTUBE_CHANNEL_URL,
          PUBLIC_FACEBOOK_URL,
          PUBLIC_PERSONAL_WEBSITE_URL,
          PUBLIC_PHILS_APP_URL,
          PUBLIC_LINKEDIN_URL
        ].filter(Boolean)
      })}
    </script>

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      src="https://www.googletagmanager.com/gtag/js?id=G-K4J7545NT7"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-K4J7545NT7");
    </script>
  </head>
  <body class="overflow-x-hidden">
    <!-- Debug: Red vertical center line (development only) -->
    {
      import.meta.env.DEV && (
        <div class="fixed top-0 left-1/2 w-px h-full bg-red-500 z-[9999] pointer-events-none transform -translate-x-0.2" />
      )
    }
    <slot />
  </body>
</html>
